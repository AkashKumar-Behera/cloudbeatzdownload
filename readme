## Commands

# Install Firebase CLI globally (only once)
npm install -g firebase-tools

# Login to Firebase
firebase login

# Initialize Firebase in your project (only first time)
firebase init hosting

# Select your Firebase project (optional)
firebase use --add

# Install all dependencies
npm install

# Run local dev server
npm run dev

# Build production files (creates dist/ folder)
npm run build

# Preview build locally (optional)
npm run preview

# Deploy hosting (main command)
firebase deploy --only hosting

# Check current active project
firebase projects:list
firebase use

# Set active project manually
firebase use <project-id>

# Clear and reinstall everything (optional)
rm -rf node_modules
npm install

# Update Firebase CLI (optional)
npm install -g firebase-tools@latest


*optional commands

# View Firebase CLI version
firebase --version

# Emulate hosting locally
firebase emulators:start

# Logout (if needed)
firebase logout

# Deploy everything (functions, hosting, etc.)
firebase deploy



* json
{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json","**/.*","**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
